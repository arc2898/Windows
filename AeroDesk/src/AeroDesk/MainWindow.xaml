<Window x:Class="AeroDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AeroDesk" Width="980" Height="700" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#01152639" Foreground="{StaticResource GlassText}" FontFamily="Segoe UI Variable, Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22">
   <Border Width="54" Height="54" CornerRadius="16" Background="#573B82AC" BorderBrush="#668BCBFF" BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,16,0"><TextBlock Text="A" FontSize="34" FontWeight="Light" Foreground="#FFB9E2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="AeroDesk" FontSize="32" FontWeight="Light"/><TextBlock Text="A glassy desktop. Your widgets. Your rules." Opacity="0.72" FontSize="13"/></StackPanel>
   <Button DockPanel.Dock="Right" Content="Open settings folder ↗" VerticalAlignment="Center" Click="OpenSettingsFolder_Click"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#372B4B68" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="20" Padding="20" Margin="0,0,10,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="WIDGET LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GlassAccent}"/><TextBlock Text="Pin a panel to your desktop" FontSize="21" Margin="0,7,0,4"/><TextBlock Text="Drag widgets to position them. Right-click a widget for its menu." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,15"/></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><UniformGrid x:Name="WidgetGrid" Columns="2"/></ScrollViewer>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Background="#372B4B68" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="20" Padding="20" Margin="10,0,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="APPEARANCE &amp; BEHAVIOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GlassAccent}"/><TextBlock Text="Make it yours" FontSize="21" Margin="0,7,0,15"/>
     <CheckBox x:Name="AcrylicCheck" Content="Use acrylic blur / glass effects" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
     <CheckBox x:Name="TopmostCheck" Content="Keep widgets above other windows" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
     <CheckBox x:Name="RestoreCheck" Content="Restore widgets after sign-in" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
     <CheckBox x:Name="StartupCheck" Content="Start AeroDesk with Windows" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
     <TextBlock Text="Widget opacity" Margin="0,16,0,4" FontWeight="SemiBold"/><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" Value="0.88" TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="Opacity_Changed"/><DockPanel><TextBlock Text="Transparent" FontSize="11" Opacity="0.65"/><TextBlock Text="Solid" DockPanel.Dock="Right" FontSize="11" Opacity="0.65"/></DockPanel>
     <Border Background="#3A8BCBFF" CornerRadius="12" Padding="12" Margin="0,20,0,0"><StackPanel><TextBlock Text="AERO GLASS, THE PRACTICAL WAY" FontSize="11" FontWeight="Bold"/><TextBlock Text="AeroDesk styles its own floating panels. Windows does not expose a supported switch to restore Windows 7 glass across every third-party title bar. No Explorer injection or system patching is used." TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,6,0,0"/></StackPanel></Border>
     <TextBlock x:Name="StatsText" Text="0 widgets active" Margin="0,18,0,0" Opacity="0.65" FontSize="12"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,17,0,0"><TextBlock Text="AeroDesk 0.2 • No Windhawk • No Rainmeter" Opacity="0.55" VerticalAlignment="Center"/><Button Content="Quit AeroDesk" DockPanel.Dock="Right" Click="Quit_Click"/></DockPanel>
 </Grid>
</Window>
