<Window x:Class="AeroDesk.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="260" Height="160" MinWidth="190" MinHeight="110" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#011A2C42" Foreground="{StaticResource GlassText}" FontFamily="Segoe UI Variable, Segoe UI" ShowInTaskbar="False" WindowStartupLocation="Manual" Loaded="Window_Loaded" Closed="Window_Closed">
 <Border x:Name="Panel" CornerRadius="14" Background="#DD1A2C42" BorderBrush="#668BCBFF" BorderThickness="1" Padding="15">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"><TextBlock x:Name="Heading" Text="AERODESK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GlassAccent}" VerticalAlignment="Center"/><TextBlock Text="  ◈" DockPanel.Dock="Right" Foreground="#AABED5" FontSize="10" VerticalAlignment="Center"/></DockPanel>
   <Grid Grid.Row="1" Margin="0,10,0,0">
    <StackPanel x:Name="ClockPanel" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="ClockText" Text="12:00" FontSize="34" FontWeight="Light" HorizontalAlignment="Center"/><TextBlock x:Name="ClockDate" Text="Tuesday, October 20" FontSize="12" Opacity="0.8" HorizontalAlignment="Center"/></StackPanel>
    <StackPanel x:Name="CalendarPanel" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="CalendarDay" FontSize="36" FontWeight="Light"/><TextBlock x:Name="CalendarMonth" FontSize="16" Foreground="{StaticResource GlassAccent}"/><TextBlock x:Name="CalendarWeekday" FontSize="12" Opacity="0.75" Margin="0,4,0,0"/></StackPanel>
    <TextBox x:Name="NotesText" Visibility="Collapsed" Background="#55374F69" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" TextChanged="NotesText_Changed" ToolTip="Notes save automatically"/>
    <StackPanel x:Name="SystemPanel" Visibility="Collapsed" VerticalAlignment="Center">
     <DockPanel><TextBlock Text="MEMORY" FontSize="10" FontWeight="Bold" Opacity="0.7"/><TextBlock x:Name="MemoryValue" DockPanel.Dock="Right" FontSize="13"/></DockPanel>
     <ProgressBar x:Name="MemoryBar" Height="5" Margin="0,6,0,12" Minimum="0" Maximum="100"/>
     <TextBlock x:Name="MemoryDetail" FontSize="12"/><TextBlock x:Name="ProcessDetail" FontSize="11" Opacity="0.65" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel x:Name="NetworkPanel" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock Text="RECEIVED" FontSize="10" Opacity="0.65"/><TextBlock x:Name="RxRate" FontSize="24"/><TextBlock Text="SENT" FontSize="10" Opacity="0.65" Margin="0,6,0,0"/><TextBlock x:Name="TxRate" FontSize="24"/></StackPanel>
    <StackPanel x:Name="BatteryPanel" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="BatteryValue" FontSize="30" FontWeight="Light"/><TextBlock x:Name="BatteryStatus" FontSize="12" Opacity="0.75"/><ProgressBar x:Name="BatteryBar" Height="5" Margin="0,9,0,0" Minimum="0" Maximum="100"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
