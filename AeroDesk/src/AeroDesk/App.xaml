<Application x:Class="AeroDesk.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="GlassText" Color="#FFF1F6FF" />
    <SolidColorBrush x:Key="GlassMuted" Color="#FFB8C8DC" />
    <SolidColorBrush x:Key="GlassAccent" Color="#FF87CEFA" />
    <SolidColorBrush x:Key="GlassPanel" Color="#D9162639" />
    <SolidColorBrush x:Key="GlassPanelSoft" Color="#8C253E58" />
    <SolidColorBrush x:Key="GlassBorder" Color="#668CCCF4" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource GlassText}" />
      <Setter Property="Background" Value="#5C3D76A0" />
      <Setter Property="BorderBrush" Value="#667FB6DE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource GlassText}" />
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource GlassText}" />
      <Setter Property="Background" Value="#66374F69" />
      <Setter Property="BorderBrush" Value="#667FB6DE" />
      <Setter Property="Padding" Value="8" />
    </Style>
  </Application.Resources>
</Application>
