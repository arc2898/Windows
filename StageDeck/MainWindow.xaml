<Window x:Class="StageDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StageDeck" Width="100" Height="100" MinWidth="1" MinHeight="1"
        WindowStartupLocation="Manual" Background="Transparent" Foreground="White"
        FontFamily="Segoe UI Variable Display, Segoe UI" WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Loaded="Window_Loaded" Closing="Window_Closing" LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <Style x:Key="ShelfCard" TargetType="Border">
      <Setter Property="Background" Value="#D9171920"/><Setter Property="BorderBrush" Value="#38FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="7"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity=".25"/></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid IsHitTestVisible="True">
    <Border x:Name="LeftRail" Width="190" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="12,42,0,42"
            Background="#CC15161D" CornerRadius="18" BorderBrush="#2CFFFFFF" BorderThickness="1" Padding="10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="4,2,4,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="STAGE" FontSize="9" FontWeight="Bold" Foreground="#B9B5FF"/><TextBlock x:Name="Heading" Text="Work" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="⋯" Click="StageMenu_Click" Padding="7,3" Background="#252630"/>
          </Grid>
          <TextBlock x:Name="ShelfCount" Text="0 windows" FontSize="10" Foreground="#AAAAB4" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="WindowCanvas"/>
        </ScrollViewer>
        <StackPanel DockPanel.Dock="Bottom" Margin="2,12,2,0">
          <Button Content="＋  Add current window" Click="AddWindows_Click" Background="#4A4771" HorizontalContentAlignment="Left"/>
          <Button Content="↔  Switch stage" Click="SwitchStage_Click" Margin="0,6,0,0" Background="#292A34" HorizontalContentAlignment="Left"/>
          <Button Content="☰  Stages" Click="ShowStages_Click" Margin="0,6,0,0" Background="#292A34" HorizontalContentAlignment="Left"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border x:Name="RightRail" Width="190" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,42,12,42"
            Background="#CC15161D" CornerRadius="18" BorderBrush="#2CFFFFFF" BorderThickness="1" Padding="10" Visibility="Collapsed">
      <StackPanel><TextBlock Text="OTHER WINDOWS" FontSize="9" FontWeight="Bold" Foreground="#B9B5FF" Margin="4,2,4,12"/><StackPanel x:Name="RightWindowCanvas"/></StackPanel>
    </Border>
  </Grid>
</Window>
